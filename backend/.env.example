# Variables de entorno del backend (copiar como .env y completar en producción).
# En desarrollo local NO es obligatorio: application.properties trae defaults.

# --- Base de datos MySQL ---
DB_URL=jdbc:mysql://localhost:3306/dosimetros_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=cambia_esta_clave

# --- JWT (usar un secreto largo y aleatorio, mínimo 32 caracteres) ---
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_32_chars
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma.
# Si el frontend se sirve detrás del mismo Nginx que el backend, dejar vacío.
CORS_ALLOWED_ORIGINS=https://tu-dominio.cl

# --- Observabilidad / debug ---
JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO
