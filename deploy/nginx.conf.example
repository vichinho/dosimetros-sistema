# Ejemplo de Nginx para servir el frontend (build de Vite) y reenviar /api al backend.
# Con esto el frontend y la API quedan en el mismo origen, por lo que no hace
# falta configurar CORS. Copiar y adaptar el dominio / rutas.

server {
    listen 80;
    server_name tu-dominio.cl;

    # Frontend: contenido estático del build (frontend/dist).
    root /var/www/dosimetros/dist;
    index index.html;

    # SPA: cualquier ruta desconocida devuelve index.html (React Router).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API: reenvío al backend Spring Boot.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
