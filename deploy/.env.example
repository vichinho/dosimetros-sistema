# Copia este archivo como .env (en la carpeta deploy/) y completa los valores.
# NO se versiona (.env está en .gitignore).

# Subdominio con el que accederás (ej. gratis en https://www.duckdns.org).
# Debe apuntar (por DNS) a la IP pública de tu servidor.
DOMAIN=dosimet.duckdns.org

# Clave del usuario de la aplicación en MySQL (la usa el backend).
DB_PASSWORD=pon_una_clave_fuerte_aqui

# Clave del usuario root de MySQL (administración de la BD).
DB_ROOT_PASSWORD=otra_clave_fuerte_distinta

# Secreto para firmar los tokens JWT. Mínimo 32 caracteres aleatorios.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
